          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(ti.threat_type, 'malicious') AS \"metric\", COUNT(*) AS \"value\" FROM dns_logs dl JOIN threat_intel ti ON dl.domain = ti.domain WHERE dl.threat_level = 'malicious' AND $__timeFilter(dl.timestamp) GROUP BY 1",
