# ─── NovaGuard Environment Configuration ───

# ── Database (PostgreSQL / TimescaleDB) ──
DATABASE_URL=postgresql+asyncpg://novaguard:novaguard_secret@postgres:5432/novaguard_db
DATABASE_URL_SYNC=postgresql+psycopg2://novaguard:novaguard_secret@postgres:5432/novaguard_db
POSTGRES_USER=novaguard
POSTGRES_PASSWORD=novaguard_secret
POSTGRES_DB=novaguard_db

# ── Redis (Cache + Celery Broker) ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Security ──
API_KEYS=["agent-key-alpha-001","agent-key-beta-002","agent-key-gamma-003"]

# ── Rate Limiting ──
RATE_LIMIT=60/minute

# ── Cache ──
CACHE_TTL_SECONDS=86400

# ── Bulk Insert ──
BULK_INSERT_SIZE=1000

# ── Agent ──
API_GATEWAY_URL=http://localhost:8000/api/v1/ingest
AGENT_API_KEY=agent-key-alpha-001
BUFFER_FLUSH_INTERVAL=5
BUFFER_FLUSH_SIZE=1000

# ── Application ──
APP_NAME=NovaGuard
APP_ENV=development
LOG_LEVEL=INFO
